rules_version = '2';
// Todo acesso de verdade passa pelo Admin SDK (servidor), que ignora estas
// regras — elas só importam se alguém um dia adicionar o SDK client-side do
// Firebase no navegador, ou rodar `firebase deploy --only firestore:rules`
// sem perceber. Por isso ficam fechadas por padrão: nenhum acesso direto do
// cliente é esperado ou suportado neste projeto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
